{
  "name": "giro-estoque",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:panel": "vite build --config vite.panel.config.js --logLevel warn",
    "predev": "npm run build:panel",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run build:panel",
    "build": "vite build && node scripts/copy-vendor.mjs",
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "test:e2e": "npm run build && playwright test",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "jsdom": "^30.1.1",
    "vite": "8.3.0"
  }
}
